<?lc
-- ============================================================================
-- AUTHENTICATION ENDPOINT WITH SALTED PASSWORDS
-- LiveCode Server RPC API Template
-- ============================================================================
--
-- Handles user login and JWT token generation with secure password hashing
--
-- Endpoint: /auth.lc?action=login
-- Method: POST
-- Body: {"username":"admin","password":"password123"}
--
-- Response: {"status":"success","data":{"token":"...","user":{...}}}
--
-- SECURITY: Uses salted SHA256 password hashing for secure authentication
--
-- See FUNCTION-REFERENCE.md for complete API documentation
-- ============================================================================

include "lib/db-functions.lc"

on startup
  put header "Content-Type: application/json"
  
  put $_GET["action"] into tAction
  
  switch tAction
    case "login"
      put handleLogin() into tResponse
      break
    default
      put jsonError("Invalid action. Use: login") into tResponse
  end switch
  
  put tResponse
end startup

startup


-- ============================================================================
-- LOGIN HANDLER
-- ============================================================================

-- Handle login request and issue JWT token
-- Reads credentials from $_POST_RAW JSON body
-- Returns: JSON response with token and user info
function handleLogin
  -- Get credentials from POST body
  put $_POST_RAW into tPostData
  
  if tPostData is empty then
    return jsonError("No credentials provided")
  end if
  
  -- Parse JSON credentials
  put JSONParser(tPostData) into tCredentials
  
  if tCredentials is not an array then
    return jsonError("Invalid JSON in request body")
  end if
  
  put tCredentials["username"] into tUsername
  put tCredentials["password"] into tPassword
  
  if tUsername is empty or tPassword is empty then
    return jsonError("Username and password required")
  end if
  
  -- Connect to database
  put dbConnect() into tConnectionID
  if tConnectionID begins with "ERROR:" then
    return jsonError(tConnectionID)
  end if
  
  -- Query user with salt and iterations
  put "SELECT id, username, password_hash, password_salt, password_iterations, name, email, is_active" into tSQL
  put " FROM users" after tSQL
  put " WHERE username = '" & sqlEscape(tUsername) & "'" after tSQL
  put " AND is_active = 1" after tSQL
  
  put revDataFromQuery(tab, return, tConnectionID, tSQL) into tData
  
  revCloseDatabase tConnectionID
  
  if tData begins with "revdberr" or tData is empty then
    return jsonError("Invalid username or password")
  end if
  
  -- Parse user data
  split tData by tab
  
  put tData[1] into tUserID
  put tData[2] into tDBUsername
  put tData[3] into tPasswordHash
  put tData[4] into tPasswordSalt
  put tData[5] into tPasswordIterations
  put tData[6] into tName
  put tData[7] into tEmail
  
  -- Verify password with enhanced hashing (iterations stored in DB)
  if tPasswordSalt is empty then
    -- Legacy unsalted hash - upgrade to enhanced version
    put messageDigest(tPassword, "SHA256") into tComputedHash
    
    if tComputedHash is tPasswordHash then
      -- Valid legacy password - upgrade to enhanced version with iterations
      put hashPasswordEnhanced(tPassword) into tEnhanced
      
      -- Validate user ID
      put validateInteger(tUserID) into tSafeUserID
      if tSafeUserID is empty then
        return jsonError("Invalid user ID")
      end if
      
      -- Update database with enhanced password (with iterations)
      put dbConnect() into tUpgradeConn
      put "UPDATE users SET password_hash = '" & sqlEscape(tEnhanced["hash"]) & "'" into tUpgradeSQL
      put ", password_salt = '" & sqlEscape(tEnhanced["salt"]) & "'" after tUpgradeSQL
      put ", password_iterations = " & tEnhanced["iterations"] after tUpgradeSQL
      put " WHERE id = " & tSafeUserID after tUpgradeSQL
      revExecuteSQL tUpgradeConn, tUpgradeSQL
      revCloseDatabase tUpgradeConn
    else
      return jsonError("Invalid username or password")
    end if
    
  else if tPasswordIterations is empty then
    -- Legacy single-iteration salted hash - upgrade to enhanced version
    if verifyPassword(tPassword, tPasswordHash, tPasswordSalt) then
      -- Valid legacy salted password - upgrade to iterations
      put hashPasswordEnhanced(tPassword) into tEnhanced
      
      -- Validate user ID
      put validateInteger(tUserID) into tSafeUserID
      if tSafeUserID is empty then
        return jsonError("Invalid user ID")
      end if
      
      -- Update database with enhanced password
      put dbConnect() into tUpgradeConn
      put "UPDATE users SET password_hash = '" & sqlEscape(tEnhanced["hash"]) & "'" into tUpgradeSQL
      put ", password_salt = '" & sqlEscape(tEnhanced["salt"]) & "'" after tUpgradeSQL
      put ", password_iterations = " & tEnhanced["iterations"] after tUpgradeSQL
      put " WHERE id = " & tSafeUserID after tUpgradeSQL
      revExecuteSQL tUpgradeConn, tUpgradeSQL
      revCloseDatabase tUpgradeConn
    else
      return jsonError("Invalid username or password")
    end if
    
  else
    -- Enhanced password verification with iterations
    put verifyPasswordEnhanced(tPassword, tPasswordHash, tPasswordSalt, tPasswordIterations) into tIsValid
    
    if tIsValid is not true then
      return jsonError("Invalid username or password")
    end if
  end if
  
  -- Generate JWT token (30 minute expiry)
  put generateJWT(tUserID, tDBUsername, tName, 1800) into tToken
  
  -- Build user object for response
  put tUserID into tUser["id"]
  put tDBUsername into tUser["username"]
  put tName into tUser["name"]
  put tEmail into tUser["email"]
  
  -- Return success with token
  put tToken into tResult["token"]
  put tUser into tResult["user"]
  
  return jsonSuccess(tResult)
end handleLogin
?>
