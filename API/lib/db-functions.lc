<?lc
-- ============================================================================
-- DATABASE & AUTHENTICATION HELPER FUNCTIONS
-- LiveCode Server RPC API Template
-- ============================================================================
--
-- All-in-one library containing:
--   - Database connection and SQL utilities
--   - JSON response formatting
--   - JWT token creation and validation
--   - Authentication helpers
--
-- Usage: include "lib/db-functions.lc" in all endpoint files
--
-- See FUNCTION-REFERENCE.md for complete API documentation
-- ============================================================================

-- Include PhotonJSON library for JSON handling
include "photon-library.lc"


-- ============================================================================
-- DATABASE CONFIGURATION
-- ============================================================================

-- Get database type
-- Returns: String - "mysql", "postgresql", "sqlite", or "odbc"
-- IMPORTANT: Change this to match your database
function getDBType
  return "mysql"
  -- Supported options:
  -- return "mysql"
  -- return "postgresql"
  -- return "sqlite"
  -- return "odbc"
end getDBType


-- Get database host
-- Returns: String - Database host (not used for SQLite)
function getDBHost
  return "localhost"
end getDBHost


-- Get database name
-- Returns: String - Database name (for SQLite: full path to .db file)
function getDBName
  return "database_name"
  -- For SQLite, use full path:
  -- return "/var/www/api/data/myapp.db"
end getDBName


-- Get database username
-- Returns: String - Database username (not used for SQLite)
function getDBUser
  return "db_user"
end getDBUser


-- Get database password
-- Returns: String - Database password (not used for SQLite)
function getDBPassword
  return "db_password"
end getDBPassword


-- Get DSN for ODBC connections
-- Returns: String - ODBC DSN name
function getODBCDSN
  return "MyODBCDSN"
  -- The DSN should be configured in your system's ODBC settings
  -- Example: "MySQL ODBC Driver", "PostgreSQL ODBC", etc.
end getODBCDSN


-- ============================================================================
-- DATABASE CONNECTION
-- ============================================================================

-- Connect to database
-- Returns: Connection ID (number) on success, error string on failure
-- Note: Automatically uses the database type configured in getDBType()
function dbConnect
  -- Get database configuration
  put getDBType() into tType
  put getDBHost() into tHost
  put getDBName() into tDatabase
  put getDBUser() into tUser
  put getDBPassword() into tPassword

  -- Open database connection based on type
  switch tType
    case "mysql"
      put revOpenDatabase("mysql", tHost, tDatabase, tUser, tPassword) into tConnectionID
      break

    case "postgresql"
      put revOpenDatabase("postgresql", tHost, tDatabase, tUser, tPassword) into tConnectionID
      break

    case "sqlite"
      -- SQLite only needs the database path (file path)
      put revOpenDatabase("sqlite", tDatabase) into tConnectionID
      break

    case "odbc"
      -- ODBC can use either DSN or connection string
      put getODBCDSN() into tDSN
      -- Using DSN (recommended):
      put revOpenDatabase("odbc", "DSN=" & tDSN & ";UID=" & tUser & ";PWD=" & tPassword) into tConnectionID
      -- Alternative: Direct connection without DSN:
      -- put revOpenDatabase("odbc", tHost, tDatabase, tUser, tPassword) into tConnectionID
      break

    default
      return "ERROR: Unknown database type:" && tType
  end switch

  if tConnectionID is a number then
    return tConnectionID
  else
    return "ERROR: Database connection failed -" && tConnectionID
  end if
end dbConnect


-- ============================================================================
-- JSON RESPONSE HELPERS
-- ============================================================================

-- Create JSON error response
-- Parameters:
--   pMessage (String) - Error message
-- Returns: JSON string {"status":"error","message":"..."}
function jsonError pMessage
  put pMessage into tResult["message"]
  put "error" into tResult["status"]
  return JSONStringify(tResult)
end jsonError


-- Create JSON success response with data
-- Parameters:
--   pData (Any) - Data to return (array, string, number)
-- Returns: JSON string {"status":"success","data":{...}}
function jsonSuccess pData
  put pData into tResult["data"]
  put "success" into tResult["status"]
  return JSONStringify(tResult)
end jsonSuccess


-- ============================================================================
-- SQL UTILITIES
-- ============================================================================

-- Escape string for safe SQL queries
-- Parameters:
--   pString (String) - String to escape
-- Returns: Escaped string safe for SQL
-- Note: Prevents SQL injection by escaping special characters
function sqlEscape pString
  replace "\" with "\\" in pString
  replace "'" with "\'" in pString
  replace quote with "\" & quote in pString
  replace return with "\n" in pString
  replace tab with "\t" in pString
  return pString
end sqlEscape


-- ============================================================================
-- JWT TOKEN FUNCTIONS
-- ============================================================================

-- Get JWT secret key for signing tokens
-- Returns: String - Secret key
-- IMPORTANT: Change this in production! Use 32+ character random string
function getJWTSecret
  return "your-secret-key-change-in-production-min-32-chars"
end getJWTSecret


-- Get JWT token expiration time in seconds
-- Returns: Number - Seconds until expiration (default: 1800 = 30 minutes)
function getJWTExpiration
  return 1800
end getJWTExpiration


-- Generate JWT token with user data (convenience wrapper)
-- Parameters:
--   pUserID (Number) - User ID
--   pUsername (String) - Username
--   pName (String) - User's full name
--   pExpiry (Number) - Optional expiration in seconds (default: 1800 = 30 min)
-- Returns: JWT token string
-- Note: Convenience function - builds payload array and calls createJWT()
function generateJWT pUserID, pUsername, pName, pExpiry
  -- Build payload array
  put pUserID into tPayload["user_id"]
  put pUsername into tPayload["username"]
  put pName into tPayload["name"]
  
  -- Add custom expiration if provided
  if pExpiry is a number and pExpiry > 0 then
    put the seconds + pExpiry into tPayload["exp"]
    put the seconds into tPayload["iat"]
    
    -- Create token without automatic expiration (we set it manually)
    put "HS256" into tHeader["alg"]
    put "JWT" into tHeader["typ"]
    
    put base64URLEncode(JSONStringify(tHeader)) into tEncodedHeader
    put base64URLEncode(JSONStringify(tPayload)) into tEncodedPayload
    
    put tEncodedHeader & "." & tEncodedPayload into tData
    put createSignature(tData, getJWTSecret()) into tSignature
    
    if tSignature begins with "ERROR:" then
      return tSignature
    end if
    
    return tEncodedHeader & "." & tEncodedPayload & "." & tSignature
  else
    -- Use default expiration from createJWT
    return createJWT(tPayload)
  end if
end generateJWT


-- Create signed JWT token
-- Parameters:
--   pPayload (Array) - User data to encode (user_id, username, etc.)
-- Returns: JWT token string (header.payload.signature)
-- Note: Automatically adds exp (expiration) and iat (issued at) claims
function createJWT pPayload
  -- Create header
  put "HS256" into tHeader["alg"]
  put "JWT" into tHeader["typ"]
  
  -- Add expiration and issued-at to payload
  put the seconds into tNow
  put tNow + getJWTExpiration() into pPayload["exp"]
  put tNow into pPayload["iat"]
  
  -- Encode header and payload
  put base64URLEncode(JSONStringify(tHeader)) into tEncodedHeader
  put base64URLEncode(JSONStringify(pPayload)) into tEncodedPayload
  
  -- Create signature
  put tEncodedHeader & "." & tEncodedPayload into tData
  put createSignature(tData, getJWTSecret()) into tSignature
  
  if tSignature begins with "ERROR:" then
    return tSignature
  end if
  
  -- Return complete JWT
  return tEncodedHeader & "." & tEncodedPayload & "." & tSignature
end createJWT


-- Verify JWT token signature and expiration
-- Parameters:
--   pToken (String) - JWT token to verify
-- Returns: Payload array on success, error string on failure
-- Note: Checks signature validity and token expiration
function verifyJWT pToken
  -- Split token into parts
  set itemDelimiter to "."
  if the number of items in pToken is not 3 then
    return "ERROR: Invalid token format"
  end if
  
  put item 1 of pToken into tEncodedHeader
  put item 2 of pToken into tEncodedPayload
  put item 3 of pToken into tReceivedSignature
  
  -- Verify signature
  put tEncodedHeader & "." & tEncodedPayload into tData
  put createSignature(tData, getJWTSecret()) into tExpectedSignature
  
  if tExpectedSignature begins with "ERROR:" then
    return tExpectedSignature
  end if
  
  if tReceivedSignature is not tExpectedSignature then
    return "ERROR: Invalid signature"
  end if
  
  -- Decode payload
  put base64URLDecode(tEncodedPayload) into tPayloadJSON
  put JSONParser(tPayloadJSON) into tPayload
  
  -- Check expiration
  put the seconds into tNow
  if tPayload["exp"] < tNow then
    return "ERROR: Token expired"
  end if
  
  return tPayload
end verifyJWT


-- Create HMAC-SHA256 signature
-- Parameters:
--   pData (String) - Data to sign
--   pSecret (String) - Secret key
-- Returns: Base64URL-encoded signature
-- Note: Used internally by createJWT and verifyJWT
function createSignature pData, pSecret
  -- Use LiveCode's messageDigest with HMAC
  put messageDigest(pData, "SHA256", pSecret) into tHash
  
  if tHash is empty then
    return "ERROR: Failed to create signature"
  end if
  
  return base64URLEncode(tHash)
end createSignature


-- Encode data to Base64URL format (URL-safe)
-- Parameters:
--   pData (String) - Data to encode
-- Returns: Base64URL string (uses - and _ instead of + and /)
-- Note: Used internally by JWT functions
function base64URLEncode pData
  put base64Encode(pData) into tEncoded
  replace "+" with "-" in tEncoded
  replace "/" with "_" in tEncoded
  replace "=" with empty in tEncoded
  return tEncoded
end base64URLEncode


-- Decode Base64URL format to original data
-- Parameters:
--   pData (String) - Base64URL string
-- Returns: Decoded string
-- Note: Used internally by JWT functions
function base64URLDecode pData
  put pData into tData
  replace "-" with "+" in tData
  replace "_" with "/" in tData
  
  -- Add padding if needed
  put the length of tData mod 4 into tPadding
  if tPadding > 0 then
    repeat (4 - tPadding) times
      put "=" after tData
    end repeat
  end if
  
  return base64Decode(tData)
end base64URLDecode


-- ============================================================================
-- AUTHENTICATION HELPERS
-- ============================================================================

-- Extract JWT token from Authorization header
-- Returns: Token string or empty
-- Note: Handles "Bearer {token}" format and raw token
function getAuthToken
  put $_SERVER["HTTP_AUTHORIZATION"] into tAuthHeader
  
  if tAuthHeader is empty then
    return empty
  end if
  
  -- Check for "Bearer " prefix
  if word 1 of tAuthHeader is "Bearer" then
    return word 2 of tAuthHeader
  end if
  
  return tAuthHeader
end getAuthToken


-- Validate JWT from Authorization header and return user data
-- Returns: User data array on success, error string on failure
-- Note: Combines getAuthToken() and verifyJWT() for convenience
function validateJWT
  put getAuthToken() into tToken
  
  if tToken is empty then
    return "ERROR: No authorization token provided"
  end if
  
  put verifyJWT(tToken) into tResult
  
  if tResult begins with "ERROR:" then
    return tResult
  end if
  
  -- Return user data from token
  return tResult
end validateJWT


-- ============================================================================
-- PASSWORD HASHING (ENHANCED WITH ITERATIONS)
-- ============================================================================

-- Generate a random salt for password hashing
-- Returns: 32-character hexadecimal salt
-- Note: Uses LiveCode's randomBytes for cryptographic randomness
function generateSalt
  -- Generate 16 random bytes (128 bits)
  put randomBytes(16) into tRandomBytes
  
  -- Convert to hexadecimal string
  put empty into tSalt
  repeat for each byte tByte in tRandomBytes
    put baseConvert(byteToNum(tByte), 10, 16) into tHex
    if the length of tHex is 1 then put "0" before tHex
    put tHex after tSalt
  end repeat
  
  return tSalt
end generateSalt


-- ENHANCED: Hash password with iterations (PBKDF2-like)
-- Parameters:
--   pPassword (String) - Plain text password
--   pSalt (String) - Salt (generated if empty)
--   pIterations (Number) - Hash iterations (default: 1000)
-- Returns: Array with keys: hash, salt, iterations
-- Note: 1000+ iterations provides strong protection against brute force
--       Performance: ~1-10ms depending on iteration count
-- RECOMMENDED: Use this for all new passwords
function hashPasswordEnhanced pPassword, pSalt, pIterations
  -- Generate salt if not provided
  if pSalt is empty then
    put generateSalt() into pSalt
  end if
  
  -- Set default iterations (1000 = good balance of security/performance)
  if pIterations is empty then
    put 1000 into pIterations
  end if
  
  -- Initial hash: SHA256(password + salt)
  put messageDigest(pPassword & pSalt, "SHA256") into tHash
  
  -- Iterate: SHA256(previous_hash + salt) repeated pIterations times
  repeat with i = 2 to pIterations
    put messageDigest(tHash & pSalt, "SHA256") into tHash
  end repeat
  
  -- Return array with hash, salt, and iteration count
  put tHash into tResult["hash"]
  put pSalt into tResult["salt"]
  put pIterations into tResult["iterations"]
  
  return tResult
end hashPasswordEnhanced


-- ENHANCED: Verify password with iteration support
-- Parameters:
--   pPassword (String) - Plain text password to verify
--   pStoredHash (String) - Stored password hash
--   pStoredSalt (String) - Stored password salt
--   pIterations (Number) - Number of iterations used (default: 1000)
-- Returns: Boolean - true if password matches, false otherwise
-- Note: Must use same iteration count as when password was hashed
function verifyPasswordEnhanced pPassword, pStoredHash, pStoredSalt, pIterations
  -- Set default iterations
  if pIterations is empty then
    put 1000 into pIterations
  end if
  
  -- Recompute hash with same parameters
  put hashPasswordEnhanced(pPassword, pStoredSalt, pIterations) into tResult
  
  -- Compare computed hash with stored hash
  return (tResult["hash"] is pStoredHash)
end verifyPasswordEnhanced


-- ============================================================================
-- SIMPLE PASSWORD HASHING (LEGACY - Use Enhanced version for new passwords)
-- ============================================================================

-- Simple hash with single SHA256 iteration (LEGACY)
-- Parameters:
--   pPassword (String) - Plain text password
--   pSalt (String) - Salt string (32 hex characters)
-- Returns: Hashed password (64 hex characters)
-- Note: LEGACY function - Use hashPasswordEnhanced() for new passwords
--       Kept for backward compatibility with existing passwords
function hashPassword pPassword, pSalt
  put messageDigest(pPassword & pSalt, "SHA256") into tHash
  return tHash
end hashPassword


-- Simple password verification (LEGACY)
-- Parameters:
--   pPassword (String) - Plain text password to verify
--   pStoredHash (String) - Stored password hash
--   pStoredSalt (String) - Stored password salt
-- Returns: Boolean - true if password matches, false otherwise
-- Note: LEGACY function - Use verifyPasswordEnhanced() for new passwords
function verifyPassword pPassword, pStoredHash, pStoredSalt
  put hashPassword(pPassword, pStoredSalt) into tComputedHash
  return (tComputedHash is pStoredHash)
end verifyPassword


-- ============================================================================
-- INPUT VALIDATION
-- ============================================================================

-- Validate that input is a positive integer
-- Parameters:
--   pValue (String) - Value to validate
-- Returns: Integer if valid, empty if invalid
-- Note: Prevents SQL injection in numeric fields
function validateInteger pValue
  -- Check if numeric
  if pValue is not a number then
    return empty
  end if
  
  -- Check if integer (no decimals)
  if pValue contains "." then
    return empty
  end if
  
  -- Check if positive
  if pValue < 1 then
    return empty
  end if
  
  -- Return as integer
  return pValue
end validateInteger
?>
