<?lc
-- ============================================================================
-- DATABASE CONNECTION CONFIGURATION
-- ============================================================================
-- WARNING: This file contains your database credentials
-- DO NOT commit this file to Git
-- Add to .gitignore: lib/settings.lc
-- ============================================================================

-- Return database type
-- Returns: String - "mysql", "postgresql", "sqlite", or "odbc"
-- Supported options:
--   - "mysql" (default) - MySQL/MariaDB
--   - "postgresql" - PostgreSQL
--   - "sqlite" - SQLite (serverless, file-based)
--   - "odbc" - ODBC (SQL Server, Oracle, DB2, Access, etc.)
function getDBType
  return "mysql"
end getDBType

-- Return database host
-- Returns: String - Database host address (not used for SQLite)
function getDBHost
  return "127.0.0.1"
end getDBHost

-- Return database name
-- Returns: String - Database name
-- For SQLite: Full path to .db file (e.g., "/var/www/api/data/myapp.db")
function getDBName
  return "echo_indications"
end getDBName

-- Return database username
-- Returns: String - Database username (not used for SQLite)
function getDBUser
  return "admin"
end getDBUser

-- Return database password
-- Returns: String - Database password (not used for SQLite)
function getDBPassword
  return "reject66"
end getDBPassword

-- Return ODBC DSN name
-- Returns: String - ODBC Data Source Name
-- Only used when getDBType() returns "odbc"
-- The DSN should be configured in your system's ODBC settings
function getODBCDSN
  return "MyODBCDSN"
end getODBCDSN



-- ============================================================================
-- SECRET KEY CONFIGURATION
-- ============================================================================
-- WARNING: This file contains your JWT secret key
-- DO NOT commit this file to Git
-- Add to .gitignore: lib/secret.lc
-- ============================================================================

-- Return JWT secret key for token signing
-- SECURITY: This key must be kept secret!
-- Returns: String - Secret key for HMAC-SHA256 signing
function getJWTSecret
  return "FSHHwdT58t9btVdSeW63wVMAjFQU92RM8Dl7jCjeuQMc39q+m0vuYDNHnvhdmfzuLVEryOKgJv+ilBKDFZFaYg=="
end getJWTSecret
?>
